<?xml version="1.0" encoding="utf-8"?>
<phone:PhoneApplicationPage
    x:Class="LumiaWiFiFix.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"
    shell:SystemTray.IsVisible="True"
    Background="#05090C">

    <ScrollViewer>
        <StackPanel Margin="18,10,18,30">

            <TextBlock Text="NOKIA LUMIA 929 &#183; ICON"
                       Foreground="#00C853" FontSize="12" />
            <TextBlock Text="Wi-Fi Fix &amp; 5 GHz Unlock"
                       Foreground="White" FontSize="26" TextWrapping="Wrap"
                       Margin="0,2,0,4" />
            <TextBlock Text="5 GHz: YES   &#183;   802.11ac: YES   &#183;   WPA2-PSK: YES   &#183;   WPA3: NO"
                       Foreground="#7EE2A8" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <Border Style="{StaticResource FixCard}">
                <StackPanel>
                    <TextBlock Text="This phone does 5 GHz" Foreground="White"
                               FontSize="17" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#CFE0D8" FontSize="14"
                               Margin="0,6,0,0"
                               Text="Snapdragon 800 with dual-band 802.11ac. WPA3 and Wi-Fi 6 live in the firmware, so no app can add them. What this app does is get the phone onto the 5 GHz band at full ac speed by fixing the router settings that keep it on 2.4 GHz." />
                </StackPanel>
            </Border>

            <TextBlock Text="5 GHz RECIPE" Foreground="#9BE7C4" FontSize="13"
                       FontWeight="SemiBold" Margin="0,10,0,6" />

            <Border Style="{StaticResource FixCard}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#CFE0D8" FontSize="14"
                               Text="On the router's 5 GHz page (not the 2.4 page):" />
                    <TextBlock TextWrapping="Wrap" Foreground="#CFE0D8" FontSize="14"
                               Margin="0,8,0,0"
                               Text="1. Security: WPA2-PSK, AES. WPA3 off.&#10;2. PMF / 802.11w: Disabled or Optional.&#10;3. Channel: 44 or 157. Never Auto, never 52-144.&#10;4. Mode: 802.11 a/n/ac mixed, width 80 MHz.&#10;5. Band steering / Smart Connect: off.&#10;6. Give 5 GHz its own SSID, e.g. Home-5G.&#10;7. Fast roaming 802.11r/k/v: off." />
                </StackPanel>
            </Border>

            <TextBlock Text="CHECKLIST" Foreground="#9BE7C4" FontSize="13"
                       FontWeight="SemiBold" Margin="0,10,0,6" />

            <CheckBox x:Name="C1" Content="5 GHz radio is on" Foreground="#CFE0D8" />
            <CheckBox x:Name="C2" Content="5 GHz has its own SSID (steering off)" Foreground="#CFE0D8" />
            <CheckBox x:Name="C3" Content="WPA2-PSK (AES) on the 5 GHz band" Foreground="#CFE0D8" />
            <CheckBox x:Name="C4" Content="PMF / 802.11w not set to Required" Foreground="#CFE0D8" />
            <CheckBox x:Name="C5" Content="Channel is 36-48 or 149-161, not DFS" Foreground="#CFE0D8" />
            <CheckBox x:Name="C6" Content="Width 80 MHz, mode a/n/ac mixed" Foreground="#CFE0D8" />
            <CheckBox x:Name="C7" Content="Fast roaming 802.11r/k/v off" Foreground="#CFE0D8" />
            <CheckBox x:Name="C8" Content="Old network deleted from the phone" Foreground="#CFE0D8" />

            <Button Content="Open Wi-Fi settings"
                    Click="OpenWiFiSettings_Click"
                    Margin="0,16,0,8" />

            <Border Style="{StaticResource FixCard}" BorderBrush="#6B2020">
                <StackPanel>
                    <TextBlock Text="What you cannot have" Foreground="#F19A9A"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#CFE0D8" FontSize="14"
                               Margin="0,6,0,0"
                               Text="WPA3, Wi-Fi 6 and 6 GHz are firmware and driver features. There is no patch, sideload or Store app that adds them to Windows Phone 8.1. If the network is WPA3-only, put a WPA2 access point on the LAN and join that instead." />
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Foreground="#4F6670" FontSize="11"
                       Margin="0,14,0,0"
                       Text="Offline app. No network access, no data collected." />

        </StackPanel>
    </ScrollViewer>
</phone:PhoneApplicationPage>
